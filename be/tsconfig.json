{
	"compilerOptions": {
		"target": "es2022",
		"module": "commonjs",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"rootDir": "./",
		"outDir": "./dist",
		"types": ["node"],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*", "prisma/**/*", "prisma.config.ts", "tests/**/*"]
}
